<mujoco model="single_joint_arm">

    <!-- ====================================== -->
    <!-- 1. 仿真参数 -->
    <!-- ====================================== -->

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
    />

    <!-- ====================================== -->
    <!-- 2. 物理世界 -->
    <!-- ====================================== -->

    <worldbody>

        <!-- 地面 -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            rgba="0.7 0.7 0.7 1"
        />

        <!-- ================================== -->
        <!-- 固定底座 -->
        <!-- ================================== -->

        <body name="base" pos="0 0 0.4">

            <geom
                name="base_geom"
                type="cylinder"
                size="0.15 0.1"
                rgba="0.3 0.3 0.3 1"
            />

        </body>

        <!-- ================================== -->
        <!-- 单关节机械臂 -->
        <!-- ================================== -->

        <body name="arm" pos="0 0 0.5">

            <!-- 绕 Z 轴旋转的关节 -->
            <joint
                name="arm_hinge"
                type="hinge"
                axis="0 0 1"
                damping="0.1"
                limited="true"
                range="-180 180"
            />

            <!-- 机械臂杆件 -->
            <geom
                name="arm_geom"
                type="capsule"
                fromto="0 0 0 1 0 0"
                size="0.06"
                mass="1"
                rgba="0.1 0.4 1 1"
            />

        </body>

    </worldbody>

    <!-- ====================================== -->
    <!-- 3. 电机执行器 -->
    <!-- ====================================== -->

    <actuator>

        <!--
        电机名称：arm_motor
        控制关节：arm_hinge
        执行器类型：motor
        传动系数：1
        最大输出力矩：±5 N·m

        Python通过data.ctrl[0]控制力矩
        -->

        <motor
            name="arm_motor"
            joint="arm_hinge"
            gear="1"
            ctrllimited="true"
            ctrlrange="-5 5"
        />

    </actuator>

</mujoco>