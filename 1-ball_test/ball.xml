<mujoco model="ball_fall">

    <!-- 设置重力和仿真步长 -->
    <option gravity="0 0 -9.81" timestep="0.002"/>

    <worldbody>

        <!-- 地面 -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            rgba="0.7 0.7 0.7 1"/>

        <!-- 小球 -->
        <body name="ball" pos="0 0 2">

            <!-- 允许小球自由运动 -->
            <freejoint/>

            <!-- 小球几何形状 -->
            <geom
                name="ball_geom"
                type="sphere"
                size="0.1"
                mass="1"
                rgba="1 0 0 1"/>

        </body>

    </worldbody>

</mujoco>